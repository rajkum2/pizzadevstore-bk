{
  "name": "pizza-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API for Pizza Ordering System",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "node migrations/migration-runner.js up",
    "migrate:rollback": "node migrations/migration-runner.js down",
    "seed": "node seeders/seeder-runner.js seed",
    "seed:clear": "node seeders/seeder-runner.js clear",
    "seed:users": "node seeders/seeder-runner.js seed users.seeder.js",
    "seed:orders": "node seeders/seeder-runner.js seed orders.seeder.js"
  },
  "keywords": ["pizza", "express", "mongodb", "stripe"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.6.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.11.2",
    "stripe": "^14.5.0",
    "swagger-ui-express": "^4.6.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
